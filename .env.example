# Variáveis de ambiente do Mapa do Mapa (Etapa 2).
# NUNCA coloque valores reais aqui nem em netlify.toml.
# Em produção, defina na Netlify (UI ou `netlify env:set`) com escopo "Functions".
# Localmente nada é necessário: o ambiente de desenvolvimento usa valores seguros só de dev.

# Segredo para assinar os códigos de SMS (mínimo 32 caracteres, aleatório). OBRIGATÓRIO em produção.
#   gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Provedor de SMS. Em produção deve apontar para um provedor real (ainda NÃO integrado).
# O valor "dev" (simulador) é recusado fora do ambiente local.
SMS_PROVIDER=

# ---- CAPTCHA (Cloudflare Turnstile) ----
# Chave PÚBLICA do widget (vai para o navegador). Defina na Netlify com escopo "Builds".
VITE_TURNSTILE_SITE_KEY=
CAPTCHA_PROVIDER=            # em produção: turnstile
TURNSTILE_SECRET_KEY=        # SECRETA, escopo Functions
TURNSTILE_HOSTNAMES=         # opcional: domínios permitidos, separados por vírgula

# ---- Pré-cadastro ----
PRE_REGISTRATION_OPEN=       # produção nasce FECHADO; "true" para abrir (não é a abertura dos pedidos)

# ---- Meta Ads (Pixel + Conversions API) ----
VITE_META_PIXEL_ID=          # PÚBLICA (aparece no código da página). Escopos: Builds + Functions
META_CAPI_ACCESS_TOKEN=      # SECRETA. Escopo: somente Functions. Nunca no código nem em logs
META_TEST_EVENT_CODE=        # opcional (Gerenciador de Eventos > Eventos de teste). Atenção: eventos de teste TAMBÉM contam
META_GRAPH_VERSION=          # opcional; padrão v25.0

# Resend: somente Functions, contexto Production. O domínio de RESEND_FROM deve estar verificado.
RESEND_API_KEY=
RESEND_FROM=
